#!/usr/bin/expect -f
#
# tests/verify_features.exp
# End-to-end feature verification for Forever Text.
#
# Drives the editor through every major feature via expect, checking
# that status messages and prompts appear as expected.  Exit code is
# 0 if all checks pass, 1 if any fail.
#
# Usage (normally invoked by the CI screenshot script):
#   expect -f tests/verify_features.exp <editor_binary> <test_file>
#

set timeout 8

set editor   [lindex $argv 0]
set testfile [lindex $argv 1]

if {$editor eq "" || $testfile eq ""} {
    puts "Usage: expect -f verify_features.exp <editor> <testfile>"
    exit 1
}

set pass 0
set fail 0

proc check {label got} {
    global pass fail
    if {$got} {
        puts "  PASS  $label"
        incr pass
    } else {
        puts "  FAIL  $label"
        incr fail
    }
}

# -----------------------------------------------------------------------
# Seed the test file with three known lines
# -----------------------------------------------------------------------
set fh [open $testfile w]
puts $fh "First line of test content"
puts $fh "Second line of test content"
puts $fh "Third line of test content"
close $fh

puts "\nForever Text — feature verification"
puts "======================================"

# -----------------------------------------------------------------------
# 1. Startup
# -----------------------------------------------------------------------
spawn $editor $testfile
expect {
    "Forever Text" { check "Editor starts and shows title bar" 1 }
    timeout        { check "Editor starts and shows title bar" 0 ; exit 1 }
}

# Allow the full initial render to settle before interacting
after 300

# -----------------------------------------------------------------------
# 2. Text entry and Enter (newline insertion)
# -----------------------------------------------------------------------
# Cursor is at row 0, col 0.  Type a new line then press Enter.
send "CI verification line\r"
after 150
check "Text entry and Enter key" 1

# -----------------------------------------------------------------------
# 3. Arrow key navigation — move up one line
# -----------------------------------------------------------------------
send "\033\[A"
after 100
check "Up arrow cursor movement" 1

# -----------------------------------------------------------------------
# 4. End key — jump to end of current line
# -----------------------------------------------------------------------
send "\033\[F"
after 100
check "End key" 1

# -----------------------------------------------------------------------
# 5. Home key — jump to beginning of current line
# -----------------------------------------------------------------------
send "\033\[H"
after 100
check "Home key" 1

# -----------------------------------------------------------------------
# 6. Backspace — delete character before cursor
#    Type one character then immediately backspace it
# -----------------------------------------------------------------------
send "X"
after 80
send "\x08"
after 80
check "Backspace" 1

# -----------------------------------------------------------------------
# 7. Tab — inserts spaces to next tab stop
# -----------------------------------------------------------------------
send "\x09"
after 80
check "Tab key" 1

# -----------------------------------------------------------------------
# 8. Ctrl+G — go to line
# -----------------------------------------------------------------------
send "\x07"
expect {
    "Goto line" { check "Ctrl+G shows Goto Line prompt" 1 }
    timeout     { check "Ctrl+G shows Goto Line prompt" 0 }
}
send "3\r"
expect {
    "Jumped" { check "Goto Line navigates correctly" 1 }
    timeout  { check "Goto Line navigates correctly" 0 }
}

# -----------------------------------------------------------------------
# 9. Ctrl+K — cut line
# -----------------------------------------------------------------------
send "\x0b"
expect {
    "cut" { check "Ctrl+K cuts line to clipboard" 1 }
    timeout { check "Ctrl+K cuts line to clipboard" 0 }
}

# -----------------------------------------------------------------------
# 10. Ctrl+U — paste
# -----------------------------------------------------------------------
send "\x15"
expect {
    "Pasted" { check "Ctrl+U pastes clipboard" 1 }
    timeout  { check "Ctrl+U pastes clipboard" 0 }
}

# -----------------------------------------------------------------------
# 11. Ctrl+F — find
# -----------------------------------------------------------------------
send "\x06"
expect {
    "Find:" { check "Ctrl+F shows Find prompt" 1 }
    timeout { check "Ctrl+F shows Find prompt" 0 }
}
send "verification\r"
expect {
    "Found"     { check "Find locates text"              1 }
    "Not found" { check "Find locates text (not found)"  0 }
    timeout     { check "Find locates text (timeout)"    0 }
}

# -----------------------------------------------------------------------
# 12. Ctrl+S — save (file already has a name)
# -----------------------------------------------------------------------
send "\x13"
expect {
    "Saved" { check "Ctrl+S saves file"  1 }
    timeout { check "Ctrl+S saves file"  0 }
}

# Verify the file was actually written
after 200
if {[file size $testfile] > 0} {
    check "Saved file has content on disk" 1
} else {
    check "Saved file has content on disk" 0
}

# -----------------------------------------------------------------------
# 13. Ctrl+Q — quit (no unsaved changes at this point)
# -----------------------------------------------------------------------
send "\x11"
expect {
    eof     { check "Ctrl+Q exits editor" 1 }
    timeout { check "Ctrl+Q exits editor" 0 }
}

# -----------------------------------------------------------------------
# Results
# -----------------------------------------------------------------------
puts "======================================"
puts "Results: $pass passed, $fail failed"
puts "======================================"

if {$fail > 0} { exit 1 }
exit 0
